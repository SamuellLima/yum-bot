# Discord Bot Token
YUM_BOT_TOKEN="your_bot_token_here"

# Postgres (docker-compose)
POSTGRES_DB=yumbot
POSTGRES_USER=yumbot
POSTGRES_PASSWORD=yourpassword

# Bot rodando na máquina (fora do Docker): use localhost e a porta publicada
DATABASE_URL="postgresql+psycopg://yumbot:yourpassword@localhost:15432/yumbot"
# Bot no Docker: o compose sobrescreve DATABASE_URL para o host interno "postgres"